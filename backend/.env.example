# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection
# Replace with your dedicated Atlas application user connection string
# Format: mongodb+srv://<app_user>:<password>@<cluster>.mongodb.net/vssp_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://vssp_app_user:REPLACE_WITH_STRONG_PASSWORD@cluster0.example.mongodb.net/vssp_db?retryWrites=true&w=majority

# Authentication Secrets
# Generate 64-char random hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_64_character_cryptographically_secure_random_string
JWT_EXPIRES_IN=8h
COOKIE_SECRET=replace_with_a_32_character_cryptographically_secure_random_string
CSRF_SECRET=replace_with_a_32_character_cryptographically_secure_random_string

# Allowed Frontend Origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Evidence Storage Configuration
# Options: 'local' (development default) or 'cloudinary' (required for Render Free ephemeral storage)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Cloudinary Configuration (Required when STORAGE_DRIVER=cloudinary or in production)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=ZEEX VSSP/Evidence

# Render / Cloud Keep-Alive (Prevents free-tier sleep after 15 min inactivity)
# Automatically detected via RENDER_EXTERNAL_URL on Render, or set manually:
KEEP_ALIVE_URL=https://your-backend-app.onrender.com
KEEP_ALIVE_INTERVAL_MINUTES=14

# Initial Account Provisioning (Used solely during safe seeding; change in production)
INITIAL_ADMIN_EMAIL=admin@vssp.local
INITIAL_ADMIN_PASSWORD=replace_with_strong_admin_password
INITIAL_OPERATOR_EMAIL=operator@vssp.local
INITIAL_OPERATOR_PASSWORD=replace_with_strong_operator_password

